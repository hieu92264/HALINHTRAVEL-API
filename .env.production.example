APP_NAME="Ha Linh Travel API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.halinh-travel.io.vn
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=halinhtravel
DB_USERNAME=halinhtravel
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=REPLACE_WITH_A_RANDOM_ID
REVERB_APP_KEY=REPLACE_WITH_A_LONG_RANDOM_KEY
REVERB_APP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
REVERB_HOST=api.halinh-travel.io.vn
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://halinh-travel.io.vn

CORS_ALLOWED_ORIGINS=https://halinh-travel.io.vn

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@halinh-travel.io.vn
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=

ACME_EMAIL=admin@halinh-travel.io.vn

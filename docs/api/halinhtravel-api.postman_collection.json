            { "name": "Deactivate route rate", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json", "type": "text" }], "url": "{{base_url}}/master-data/route-rates/{{route_rate_id}}", "description": "Sets is_active to false, so the rate is excluded from lookup." } }

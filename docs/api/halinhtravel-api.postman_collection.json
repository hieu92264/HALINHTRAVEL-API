            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"reports.view\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/permissions"
          }
        },
        {
          "name": "Update permission",

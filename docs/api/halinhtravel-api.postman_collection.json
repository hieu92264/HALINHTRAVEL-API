            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"permission_ids\": [1]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/users/{{user_id}}/permissions"
          }
        }

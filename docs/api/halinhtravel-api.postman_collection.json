            {
              "name": "Create customer",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const response = pm.response.json();", "if (response.metadata && response.metadata.id) {", "    pm.collectionVariables.set('customer_id', String(response.metadata.id));", "}"] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],

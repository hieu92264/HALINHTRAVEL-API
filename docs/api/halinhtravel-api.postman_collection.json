            { "name": "Deactivate customer", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json", "type": "text" }], "url": "{{base_url}}/master-data/customers/{{customer_id}}", "description": "Sets is_active to false; the record remains available in list and show responses." } }
          ]

            "body": { "mode": "raw", "raw": "{\n  \"user_name\": \"new_user\",\n  \"email\": \"new.user@example.test\",\n  \"password\": \"password123\",\n  \"is_active\": true,\n  \"role_ids\": [1]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/users"
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"updated.user@example.test\",\n  \"password\": \"newpassword123\",\n  \"is_active\": true\n}", "options": { "raw": { "language": "json" } } },

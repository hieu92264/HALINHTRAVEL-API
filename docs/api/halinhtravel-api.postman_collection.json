              "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"route_id\": {{route_id}},\n  \"vehicle_type_id\": {{vehicle_type_id}},\n  \"customer_price\": \"1250000.00\",\n  \"driver_wage\": \"300000.00\",\n  \"effective_from\": \"2026-01-01\",\n  \"effective_to\": null\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/master-data/route-rates", "description": "The effective period must not overlap an active rate for the same route and vehicle type." }

        {
          "name": "List all roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/auth/roles/all"
          }
        },
        {
          "name": "Get role",
          "request": {
            "method": "GET",

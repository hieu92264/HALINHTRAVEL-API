            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"operations-manager\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/roles"
          }
        },
        {
          "name": "Update role",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"operations-lead\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/roles/{{role_id}}"
          }
        },
        {
          "name": "Delete role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/auth/roles/{{role_id}}"
          }
        },
        {
          "name": "Sync role permissions",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"permission_ids\": [1]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/roles/{{role_id}}/permissions"
          }
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "List permissions",
          "request": {

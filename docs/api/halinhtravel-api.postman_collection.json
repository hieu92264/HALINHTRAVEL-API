              "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"company\",\n  \"full_name\": \"Nguyễn Văn A\",\n  \"phone\": \"0901234567\",\n  \"cccd\": \"001234567890\",\n  \"license_number\": \"B2-123456\",\n  \"license_class\": \"B2\",\n  \"license_issued_at\": \"2024-01-01\",\n  \"license_expired_at\": \"2029-01-01\",\n  \"base_salary\": \"12000000.00\",\n  \"responsibility_allowance\": \"500000.00\",\n  \"joined_at\": \"2026-01-01\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/master-data/drivers", "description": "Use type partner with partner_id for partner drivers; company drivers do not require a user account." }

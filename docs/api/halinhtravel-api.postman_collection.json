            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": { "raw": "{{base_url}}/auth/permissions?per_page=15", "query": [{ "key": "per_page", "value": "15", "description": "1-100; defaults to 15" }] }
          }
        },
        {
          "name": "List all permissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/auth/permissions/all"
          }
        },
        {
          "name": "Get permission",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/auth/permissions/{{permission_id}}"
          }
